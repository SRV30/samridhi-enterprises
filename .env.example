# =========================================================================
# Samridhi Enterprises — Root Environment Variables
# =========================================================================
# This file consolidates all required environment variables for both the
# client and server. Copy this file to `.env` and fill in the values.
#
# For more details, see:
#   - server/.env.example   (server-specific variables with descriptions)
#   - client/.env.example   (client-specific variables)
#   - docs/ENVIRONMENT.md   (full reference documentation)
# =========================================================================

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"               # "development" | "production"
TRUST_PROXY=                         # Set when behind a reverse proxy (true | 1 | IP)

# ── Database ────────────────────────────────────────────────────────────
MONGODB_URL=                         # MongoDB Atlas connection string

# ── CORS ────────────────────────────────────────────────────────────────
FRONTEND_URL=""                      # Production frontend URL
FRONTEND_WWW_URL=""                  # Production frontend www URL

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=                          # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_EXPIRE="5d"
COOKIE_EXPIRE=7

# ── Email (Brevo / Sendinblue) ──────────────────────────────────────────
BREVO_API_KEY=                       # Set "dummy" to skip sending in dev
BREVO_SENDER_EMAIL="noreply@samridhienterprises.com"
BREVO_SENDER_NAME="Samridhi Enterprises"

# ── Image Storage (Cloudinary) ──────────────────────────────────────────
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OTP ─────────────────────────────────────────────────────────────────
# Set to "dev" to log OTPs to the console instead of sending emails.
# Leave empty or set to "production" for normal email-based delivery.
OTP_MODE="dev"

# ── Client (Vite) ──────────────────────────────────────────────────────
# Backend API base URL (default: http://localhost:5000)
VITE_BACKEND_URL="http://localhost:5000"
